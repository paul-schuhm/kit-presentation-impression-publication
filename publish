#!/usr/bin/bash

# This program prints Markdown files (slide decks, standard documents) 
# to different formats (HTML, HTML Single Page, PDF and epub) and
# allows to publish them on a remote ftp server.
#
# Dependencies: this program uses and requires marp, pandoc and lftp.
# See https://github.com/marp-team/marp
# See https://pandoc.org/
# See https://lftp.yar.ru/

# == ALIASES ==
ENV_FILE_FILENAME="config.pp"
WORKING_DIR=$(pwd)
OUTPUT_DIR="$WORKING_DIR/public"
ENV_FILE="$WORKING_DIR/$ENV_FILE_FILENAME"

LOCAL_LUA="$WORKING_DIR/pp-h2-link.lua"
GLOBAL_LUA="/usr/local/bin/pp-h2-link.lua"

if [[ -f "$LOCAL_LUA" ]]; then
    LUA_FILTER="$LOCAL_LUA"
elif [[ -f "$GLOBAL_LUA" ]]; then
    LUA_FILTER="$GLOBAL_LUA"
else
    echo "Error: Lua filter pp-h2-link.lua (for printing to HTML Single Page) not found."
    exit 1
fi

# == FUNCTIONS ==

function init_directory(){
	echo "Init..."
	echo "Creating a config file $ENV_FILE_FILENAME"
	mkdir -p assets public
	cat << EOF > "$ENV_FILE_FILENAME"
#slide-decks
SOURCES_SLIDES=(
)

#standalone documents
SOURCES_DOCS=(
)

#Printing: Formats printed by default
do_print_html_single=true
do_print_html_deck=true
do_print_pdf=false
do_print_epub=false

#Publishing: enable/disable
do_publish_on_ftp_server=false

#Publishing: Prints published by default
do_publish_html_single=true
do_publish_html_pdf=true
do_publish_html_deck=false
do_publish_html_epub=false

#FTP Credentials
FTP_HOST=""
FTP_USER=""
FTP_PASS=""
REMOTE_DIR=""
EOF
	echo "Done"
}

function show_help() {
    cat <<EOF
Usage: $0 [CMD] [options]

CMD:

init	            Initialize directory (config, folders)
clean               Delete previsous published content (not the sources)

Options:

--html-deck         Generate HTML deck
--html-single       Generate single-page HTML (standalone)
--pdf               Generate PDF
--slides-only       Only HTML (Deck and Single Page)
--epub              Generate EPUB
--no-html-single    Do not generate single-page HTML
--no-html-deck      Do not generate HTML deck
--no-pdf            Do not generate PDF
--no-epub           Do not generate EPUB
-h, --help          Show this help message
EOF
    exit 0
}

# Check if a source file needs rebuilding
needs_rebuild() {
    local src="$1"
    local target="$2"
    
    # If target doesn't exist, we must build
    if [[ ! -f "$target" ]]; then
        return 0 
    fi
    
    # If source is newer than target, we must rebuild
    if [[ "$src" -nt "$target" ]]; then
        return 0
    fi

    return 1
}

# Ensure local stylesheet exists
function ensure_style() {
    local style_file="$1"
    if [ ! -e "$style_file" ]; then
        touch "$style_file"
        echo "Local stylesheet ($(basename "$style_file")) created"
    fi
}

# Print slide-deck to slide-deck html (for live presentation)
function mdslide2htmldeck() {
    local file="$1"
    local filename=$(basename "$file" .md)
    local target="${OUTPUT_DIR}/${filename}-deck.html"
    ensure_style "$WORKING_DIR/style.css"
    marp --html --allow-local-files --theme "$WORKING_DIR/theme.css" "$1" \
        -o "$target" 2>dev/null
}

# Print slide-deck Markdown document to slide-deck PDF
function mdslide2PDFdeck() {
    local file="$1"
    local filename=$(basename "$file" .md)
    local target="${OUTPUT_DIR}/${filename}-deck.pdf"

    if ! needs_rebuild "$file" "$target"; then
        echo "  [Skipped] $filename-deck.pdf is up to date."
        return 0
    fi

    echo "Printing $filename to PDF..."
    ensure_style "$WORKING_DIR/style.css"
    marp --html --allow-local-files --theme "$WORKING_DIR/theme.css" --pdf "$file" \
        -o "$target" 2>/dev/null
}

# Print slide-deck Markdown document to HTML Single Page document
function mdslide2htmlsingle(){

    local file="$1"
    local filename=$(basename "$file" .md)
    local target="${OUTPUT_DIR}/${filename}.html"

    if ! needs_rebuild "$file" "$target"; then
        echo "[Skipped] $filename.html is up to date."
        return 0
    fi

    ensure_style "$WORKING_DIR/style.css"

    local tmp_file

    tmp_file=$(mktemp --suffix=.md)

    # Clean temp file at the end of the function
    trap 'rm -f "$tmp_file"' RETURN

    # Add .marp-bg-img class to slide background images (marp format) to temp file 
    sed 's/!\[bg \([^]]*\)\](\([^)]*\))\({\.marp-bg-img}\)\?/![bg \1](\2){.marp-bg-img}/g' "$file" > "$tmp_file"

    pandoc "$tmp_file" -f markdown+tex_math_double_backslash -t html5 -s \
         -o "$target" \
        --toc --toc-depth=2 \
        --lua-filter "$LUA_FILTER" \
        --standalone \
        --strip-comments \
        --mathml \
        --css "$WORKING_DIR/style.css" \
        --self-contained
}

# Print standard Markdown document to HTML Single
function md2htmlsingle(){
  filename=$(basename "$file" .md)

    ensure_style "$WORKING_DIR/style.css"

	pandoc $1 -f markdown+tex_math_double_backslash -t html5 -s -o ${OUTPUT_DIR}/${filename}.html --lua-filter "$LUA_FILTER" --standalone  --strip-comments --mathml --css  "$WORKING_DIR"/style-single.css --self-contained
}


# Print standard Markdown document to PDF
 function md2pdf(){

    local file="$1"
    local filename=$(basename "$file" .md)
    local target="${OUTPUT_DIR}/${filename}.pdf"

    if ! needs_rebuild "$file" "$target"; then
        echo "[Skipped] $filename.pdf is up to date."
        return 0
    fi

    ensure_style "$WORKING_DIR/style.css"

    pandoc "$file" -f markdown+tex_math_double_backslash -t html5 \
        -o "$target" \
        --strip-comments --mathml --css "$WORKING_DIR/style.css" 2>/dev/null
 }

 # Print standard Markdown document to EPUB
 function md2epub(){
    local file="$1"
    local filename=$(basename "$file" .md)
    local target="${OUTPUT_DIR}/${filename}.epub"

    if ! needs_rebuild "$file" "$target"; then
        echo "  [Skipped] $filename.epub is up to date."
        return 0
    fi

    echo "Printing $filename to EPUB ..."
    ensure_style "$WORKING_DIR/style.css"

    pandoc "$file" \
        -f markdown+tex_math_double_backslash \
        -t epub \
        -o "$target" \
        --css "$WORKING_DIR/style.css" \
        --mathml 2>/dev/null
 }

# == BEGINNING OF THE SCRIPT ==

if [ "$1" = "init" ]; then
	init_directory
	exit 0
fi

#Load options from configuration file
if [[ -f "$ENV_FILE" ]]; then
    source "$ENV_FILE"
else
    echo "Error: $ENV_FILE_FILENAME not found in $WORKING_DIR."
    echo "Create a configuration file $ENV_FILE_FILENAME with pp init"
    echo "Use --help for help"
    exit 1
fi


# Handle user options
while [ $# -gt 0 ]; do
    case "$1" in
        --html-single) do_print_html_single=true ;;
        --no-html-single) do_print_html_single=false ;;

        --html-deck) do_print_html_deck=true ;;
        --no-html-deck) do_print_html_deck=false ;;

        --pdf) do_print_pdf=true ;;
        --no-pdf) do_do_print_pdf=false ;;

        --epub) do_print_epub=true ;;
        --no-epub) do_print_epub=false ;;

        --slides-only)
            do_print_html_single=true
            do_print_html_deck=true
            do_print_pdf=false
            do_print_epub=false
            ;;

        --no-ftp)
          do_publish_on_ftp_server=false
          ;;

        --ftp)
          do_publish_on_ftp_server=true
          ;;

        --all)
            do_publish_html_single=true
            do_publish_html_deck=true
            do_publish_pdf=true
            do_publish_epub=true
            ;;

        clean)
            echo "Cleaning $OUTPUT_DIR..."
            rm -rf "$OUTPUT_DIR"/*
            echo "...done."
            exit 0
            ;;

        -h|--help) show_help ;;
        *)
            echo "Unknown option : $1" >&2
            exit 1
            ;;
    esac
    shift
done

# Print

echo "Printing..."
echo "Slide decks to print: ${#SOURCES_SLIDES}"
echo "Documents to print: ${#SOURCES_DOCS}"

if [[ "${#SOURCES_SLIDES}" -eq 0 && "${#SOURCES_DOCS}" -eq 0 ]];then
	echo "Nothing to print";
	exit 0;
fi

# Prefix all sources
for i in "${!SOURCES_SLIDES[@]}"; do
    SOURCES_SLIDES[$i]="$WORKING_DIR/${SOURCES_SLIDES[$i]}"
done

for i in "${!SOURCES_DOCS[@]}"; do
    SOURCES_DOCS[$i]="$WORKING_DIR/${SOURCES_DOCS[$i]}"
done


# Sync assets in public
echo "Sync assets..."
mkdir -p "${WORKING_DIR}/public/assets"
cp -rn assets "${OUTPUT_DIR}"
echo "...done"

# Print slide decks
for file in "${SOURCES_SLIDES[@]}"; do

    if [[ ! -f "$file" ]]; then
        echo "Warning : file $file does not exist. Skipping file."
        continue
    fi

    base=$(basename "$file" .md)

        echo "Printing $base:"

    if $do_print_html_deck; then
       echo "To HTML Slide Deck"
       mdslide2htmldeck "$file" 2>/dev/null
    fi

    if $do_print_html_single; then
        echo "To HTML Single Page"
        mdslide2htmlsingle "$file"
    fi

    if $do_print_pdf; then
      echo "To PDF"
      mdslide2PDFdeck "$file" 2>/dev/null
    fi

    if $do_print_epub; then
        echo "To EPUB"
        md2epub "$file" 2>/dev/null
    fi
done

# Print standard document (SOURCES_DOCS)
for file in "${SOURCES_DOCS[@]}"; do

    if [[ ! -f "$file" ]]; then
        echo "Warning : file $file does not exist. Skipping file."
        continue
    fi

    base=$(basename "$file" .md)

        echo "Printing ${filename%%.*}..."

    if $do_print_html_single; then
        echo "To HTML"
        # md2htmlsingle "$file" 2>/dev/null
        md2htmlsingle "$file"
    fi

    if $do_print_pdf; then
      echo "To PDF"
      md2pdf "$file" 2>/dev/null
    fi

    if $do_print_epub; then
        echo "To EPUB"
        md2epub "$file" 2>/dev/null
    fi
done

echo "...done"

# Publish on FTP server
if $do_publish_on_ftp_server; then

	echo "Publishing (FTP server)...";

  # Iterate through all sources
  for src in "${SOURCES_SLIDES[@]}" "${SOURCES_DOCS[@]}"; do

    filename=$(basename "$src")      
    base="${filename%%.*}"     

    #Build selection of files to publish (based on user choices)
    files_to_publish=()
        [ "$do_publish_html_deck" = true ] && files_to_publish+=("${OUTPUT_DIR}/${base}-deck.html")
        [ "$do_publish_html_single" = true ] && files_to_publish+=("${OUTPUT_DIR}/${base}.html")
        [ "$do_publish_pdf" = true ] && files_to_publish+=("${OUTPUT_DIR}/${base}-deck.pdf")
        [ "$do_publish_pdf" = true ] && files_to_publish+=("${OUTPUT_DIR}/${base}.pdf")
        [ "$do_publish_epub" = true ] && files_to_publish+=("${OUTPUT_DIR}/${base}.epub")

    # Iterate through selected prints to publish
     for file in "${files_to_publish[@]}"; do

        echo "Publishing ${filename%%.*}..."

        if [[ ! -f "$file" ]]; then
          echo "Error : file $file does not exist."
          continue
        fi
      
        if lftp -u "$FTP_USER","$FTP_PASS" "$FTP_HOST" <<EOF
cd $REMOTE_DIR
put $file
bye
EOF
        then
        echo "File $file published on $FTP_HOST/$REMOTE_DIR."
        else
        echo "Error: Failed to upload $file" >&2
        fi
    done
  done
  echo "...done"
fi
